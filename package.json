	"type": "module",
	"license": "MIT",
	"author": "mattKg",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mattKg/pi-ollama-quota.git"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"ollama",
		"ollama-cloud",
		"usage",
		"quota",
		"footer",
		"tui"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"files": [
		"index.ts",
		"api.ts",
		"options.ts",
		"render.ts",
		"footer.ts",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "node --test test/api.test.ts test/options.test.ts test/render.test.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	}
